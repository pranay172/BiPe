__pycache__/
.pytest_cache/
*.pyc
.uv-cache/
.ruff_cache/
*.FCBak
*.FCStd1
.local-tools/
firmware/build/
# make -C firmware config output; it embeds config hashes, so it is never committed
firmware/include/generated_config.h
# python -m bipe.m13.export output (about 0.7 MB); the export rebuilds it from the checkpoint
firmware/include/generated_locomotion_weights.h
firmware/include/generated_locomotion_parity.h
*.kicad_prl
*-backups/
*.lck
logs/
artifacts/milestone-4/continuation/component-sources/*.zip

*.blend1
artifacts/milestone-5/release/*.tar.gz
artifacts/m11/packaging/vendor/*
!artifacts/m11/packaging/vendor/SOURCES.md
# Review meshes of the M10 end-stop and knee-stop option studies (10-15 MB each);
# cad/m10/end_stop_options.py and knee_stop_options.py rebuild them
artifacts/m10/end_stop/*/render-mesh.json.gz
artifacts/m10/knee_stop/*/render-mesh.json.gz
# M12 phase D following-off reruns: duplicates of the records, compared in
# artifacts/m12/following/regression/summary.json (the metrics tables are kept)
artifacts/m12/following/regression/speed/cases.json
artifacts/m12/following/regression/speed/config.json
artifacts/m12/following/regression/speed/speed_cases.png
artifacts/m12/following/regression/m10_*/summary.json
artifacts/m12/following/regression/m10_*/robustness.png
# M12 phase F example frame images (about 20 MB per check; regenerated by the runner)
artifacts/m12/following_rendered*/images/

# Local, untracked working files (logs, scratch scripts)
local/

# Workstation tooling outputs (MCP checks, third-party wheels): kept local, not published
artifacts/tooling/
