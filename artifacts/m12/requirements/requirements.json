{
 "status": "proposed requirements for sign-off; evidence: layout study and ideal follower under stated assumptions (no balance dynamics, no perception)",
 "following": {
  "description": "M12 camera-following requirements, proposed in phase A for the user's sign-off at the phase exit. Each value carries its basis. bipe.m12.requirements checks them against the head-camera geometry and the ideal follower and writes artifacts/m12/requirements/requirements.json.",
  "status": "signed off by the user on 20 October 2026 as proposed, with the waist-tag layout, the Wide lens, and the brief brake-and-reacquire of a single worn tag in 1 m curves and 90 degree corners accepted; amended at the phase D sign-off on 22 October 2026 (range.band_m floor 0.6 m, loss.coast_s 0.45 s with a 0.95 m stopping distance; the slope-start peak pitch and the delay_15ms_noise_x2 falls accepted as recorded in docs/milestones/12-camera-following-plan.md)",
  "range": {
   "nominal_m": 1.0,
   "band_m": [
    0.6,
    1.5
   ],
   "basis": "Phase D sign-off (22 October 2026): the floor is 0.6 m, lowered from 0.7 m. In the phase D closed loop the range dips to 0.63-0.66 m (0.58 m at 0.20 s latency) when the target stops or crosses, the latency plus the robot's stopping response; it never comes near the 0.4 m stop range. Close enough for the tag to stay large in the image, far enough that a stopping person is not reached before the robot brakes (loss stopping distance below). The band holds while the target stays inside the target limits; a faster approach may take the range below the band, never below close_range.stop_range_m."
  },
  "bearing": {
   "steady_tolerance_deg": 10,
   "basis": "Straight following keeps the tag near the image centre, leaving most of the field of view for turns and lateral motion. Transient bearing is bounded by the field of view less the edge margin (no loss)."
  },
  "target": {
   "speed_max_m_s": 1.0,
   "acceleration_max_m_s2": 1.0,
   "lateral_acceleration_max_m_s2": 0.5,
   "curve_radius_min_m": [
    [
     0.7,
     1.0
    ],
    [
     1.0,
     2.0
    ]
   ],
   "corner": {
    "radius_m": 0.3,
    "speed_m_s": 0.5
   },
   "lateral_speed_max_m_s": 1.0,
   "basis": "User decision (19 October 2026): follow to about 1.0 m/s, a slow-to-normal walk. 1.0 m/s^2 covers gait initiation and stopping at a walk. Curves keep the lateral acceleration at 0.5 m/s^2 (1 m radius at 0.7 m/s, 2 m at 1.0 m/s); a 90 degree corner is taken at 0.5 m/s on a 0.3 m radius. A carried tag may move sideways across the view at up to 1.0 m/s (1 rad/s of bearing at the nominal range)."
  },
  "engage": {
   "consecutive_detections": 5,
   "minimum_s": 0.15,
   "range_m": [
    0.5,
    1.5
   ],
   "basis": "Following starts from hold only after a stable track: five consecutive detections spanning at least 0.15 s with the range inside the engage window. A single false detection cannot start the robot."
  },
  "loss": {
   "coast_s": 0.45,
   "brake_deceleration_m_s2": 1.0,
   "stopping_distance_max_m": 0.95,
   "search": false,
   "basis": "Phase D sign-off (user decision, 22 October 2026): the coast is a flat 0.45 s, lengthened from 0.3 s so that it outlasts the 0.26-0.34 s full-frame search after a miss (phase D lost the target in 90 degree corners and 1 m curves for longer than the 0.3 s coast). The user accepted the longer stop: from the 1.0 m/s target speed, 0.45 m coasting plus 0.5 m braking at 1.0 m/s^2 is 0.95 m (it was 0.8 m with the 0.3 s coast). Without a detection the follower coasts on its prediction for 0.45 s (a short occlusion, a missed frame or the re-acquisition search), then brakes to hold at 1.0 m/s^2 and holds the heading. From 1.0 m/s that is 0.45 m coasting plus 0.5 m braking, 0.95 m, inside the 1.0 m nominal range, so the robot stops short of where the person was when last seen. No search: a lost target leaves the robot balancing at hold."
  },
  "reacquisition": {
   "gate_m": 0.3,
   "basis": "During the coast or the braking, a detection within 0.3 m of the predicted target position resumes following at once. Once the robot is at hold, the engage rule applies again."
  },
  "close_range": {
   "reverse_speed_max_m_s": 0.3,
   "stop_range_m": 0.4,
   "basis": "The robot backs away from an approaching target at no more than the validated 0.3 m/s reverse speed; below 0.4 m it holds rather than reversing further."
  },
  "tag": {
   "family": "tag36h11 (phase C confirms with the detector)",
   "size_m": 0.16,
   "size_definition": "edge of the black square; with the one-cell white border the printed tag is 0.20 m, an A4 sheet",
   "layout": "waist_tag",
   "layout_decision": "User decision (20 October 2026): the waist tag, with the head camera re-pitched to about 42 degrees in phase E; the low-tag layout stays in the checks for comparison",
   "layouts": {
    "low_tag": {
     "centre_height_m": 0.4,
     "camera_pitch_deg": 15,
     "note": "current head; the tag is worn low on the back of the leg or carried low"
    },
    "waist_tag": {
     "centre_height_m": 0.95,
     "camera_pitch_deg": 42,
     "note": "tag on a belt at the back of the waist; needs the head camera re-pitched from 15 to 42 degrees (a head CAD change, phase E)"
    }
   },
   "max_view_angle_deg": 60,
   "minimum_pixels_per_cell": 3,
   "cells_across_black_square": 8,
   "basis": "Size: the largest tag with its white border on an A4 sheet. Detection needs at least 3 pixels per cell; at the 1.5 m band edge and a 60 degree view angle with the Wide lens that takes an image about 1100 pixels wide (camera.image_width_px). Height: the tag must stay inside the vertical field of view across the 0.5-1.5 m ranges, the operating postures and the balancing pitch (see the geometry table). With the 15 degree camera that is a low tag (Wide lens 0.17-0.62 m); a waist tag needs the camera pitched to about 42 degrees. The two layouts are a decision for the user. View angle: phase C measures the detector's limit."
  },
  "camera": {
   "edge_margin_fraction": 0.1,
   "body_pitch_allowance_deg": 8,
   "perception_latency_s_assumption": 0.1,
   "detection_rate_hz_assumption": 30,
   "lens_proposal": "wide",
   "lens_decision": "User decision (20 October 2026): the Wide lens; phase C confirms the fit of its 12.4 mm depth in the head",
   "image_width_px": 1152,
   "basis": "Image width: 1152 pixels, half of the 2304 x 1296 sensor mode, keeps 3 pixels per tag cell at 1.5 m and a 60 degree view angle with the Wide lens; phase C checks the detection rate at that size on the Pi Zero 2 W. Edge margin: the tag is kept 10 % of the half field of view inside the image edge (lens distortion and detector border). Pitch: the quasi-static lean atan(a/g) at the phase B acceleration target (1.25 m/s^2: 7.3 degrees), rounded up; the M10 acceptance peak under 2 N s pushes is 5.8 degrees. Latency and rate: exposure, transfer, detection and the link, assumptions phase C replaces with a measured budget. Lens: the Wide lens is proposed because the standard lens leaves a 6 cm tag-height band and no bearing-rate margin at 1 rad/s; phase C makes the choice."
  },
  "ideal_follower": {
   "dt_s": 0.01,
   "range_gain_1_s": 1.0,
   "bearing_gain_1_s": 2.5,
   "speed_lag_s": 0.2,
   "yaw_lag_s": 0.2,
   "coast_s": 0.3,
   "basis": "Coast: the ideal follower keeps the phase A 0.3 s coast, so its traces stay the phase B and phase C replay inputs as recorded; the phase D sign-off lengthened the firmware follower's coast (loss.coast_s). Perfect target knowledge and no balance dynamics: commands from the range and bearing errors with the target's own motion fed forward, applied through first-order lags of 0.2 s (the M10 heading lag in the turn case, artifacts/m12/requirements/yaw_response)."
  }
 },
