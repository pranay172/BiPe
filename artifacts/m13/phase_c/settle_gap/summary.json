      "iterations": 20,
      "impratio": 1.0,
      "basis": "Starting point for the timestep study (1, 0.5, 0.25 ms). No noslip iterations: MuJoCo Warp does not run them."
    },
    "drives": {
      "hip_belt": "rigid",
      "knee_belt": "spring",
      "hip_belt_basis": "Rotors folded into the leg hinges as armature (ratio^2 x rotor inertia about its axis). The full plant's hip belt mode is about 210 Hz (350 N m/rad on 2e-4 kg m^2), too fast for a 1 ms step with an explicit spring.",
      "knee_belt_basis": "The 1:1 knee belt is a fixed tendon spring between the knee-drive hinge and the actual shin angle (hip + shin), with the M10 stiffness and damping; its mode is about 90 Hz. Lash: the spring's rest length is offset by half the lash on the side the standing load takes up (knee_lash static); reversals are not modeled.",
      "knee_lash": "static"
    },
    "friction": {
      "hip_frictionloss_Nm": 0.00425,
      "knee_drive_frictionloss_Nm": null,
      "shin_frictionloss_Nm": null,
      "wheel_frictionloss_Nm": null,
      "basis": "null takes the full plant's load-free value: hip pretension bearing moment plus the RO40 rotor Coulomb term referred through the belt (ratio x coulomb_motor), the knee bearing Coulomb term, and the GL40 Coulomb term. The load-dependent bearing and belt-loss terms are left to the fit."
    },
    "contact": {
      "tire_solref": [
        0.002,
        1.0
      ],
      "tire_solimp": [
        0.95,
        0.99,
        0.001,
        0.5,
